# ---------------------------------------------------------------------------
# Devora environment variables
#
# Local development: copy this file to `.env` and fill in the values.
# Production: add them in Vercel -> Project -> Settings -> Environment Variables.
#
# Users bring their own Gemini/Groq key (BYOK) inside the app. These variables
# only power the built-in Devora key, which plan subscribers share and which is
# restricted to Pro-tier models. Leave them empty to keep Devora strictly BYOK.
# ---------------------------------------------------------------------------

# Shared key for requests that carry no BYOK key. Primary provider today.
DEVORA_GROQ_API_KEY=""

# Optional fallback for the Groq key above. Either one is enough.
GROQ_API_KEY=""

# Shared Gemini key. Kept for symmetry; not used while Devora's key is Groq.
DEVORA_GEMINI_API_KEY=""

# Optional fallback for the Gemini key above.
GEMINI_API_KEY=""

# Optional: port for the local dev server (default 3000).
# PORT="3000"
